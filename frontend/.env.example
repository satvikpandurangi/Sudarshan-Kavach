# Backend API Endpoint:
# Local development: http://127.0.0.1:8000
# Production (Vercel): Set to your deployed Railway backend URL (e.g., https://digital-safety-co-pilot-production.up.railway.app)
BACKEND_URL=http://127.0.0.1:8000

# Canonical Public App URL (used for SEO OpenGraph and metadata base)
# Local development: http://localhost:3000
# Production (Vercel): Set to your Vercel deployment domain (e.g., https://sudarshan-kavach.vercel.app)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional Server-Side Threat Intelligence / AI Providers (for local standalone mode):
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
# VIRUSTOTAL_API_KEY=

