# ==============================================================================
# DIGITAL SAFETY CO-PILOT - BACKEND ENVIRONMENT CONFIGURATION (RAILWAY / FASTAPI)
# ==============================================================================

# Server Port (provided automatically by Railway; default 8000 locally)
PORT=8000

# CORS Allowed Origins
# Use '*' to allow all origins, or supply comma-separated URLs:
# CORS_ORIGINS=https://sudarshan-kavach.vercel.app,http://localhost:3000
CORS_ORIGINS=*

# Reasoning Model Providers (Optional — defaults to deterministic rules engine if unset):
# 1. Groq (High speed inference - Qwen / Llama)
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# 2. Anthropic (Claude 3.5 Sonnet)
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Optical Character Recognition (Optional - for screenshot analysis):
# If running in Docker (Railway), tesseract is pre-installed at system PATH.
# If running locally on Windows:
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Environment mode (development / production)
ENVIRONMENT=production
